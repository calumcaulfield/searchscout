# Which catalogue backend to use.
#   demo    — bundled synthetic catalogue, no credentials, the default
#   magento — a real Magento 2 store
SCOUT_ADAPTER=demo

# Only needed when SCOUT_ADAPTER=magento.
# The store URL is configuration, never a code constant: it identifies the
# customer, and the original hard-coded it.
SCOUT_MAGENTO_BASE_URL=https://demo-store.example.com/rest/V1
SCOUT_MAGENTO_API_TOKEN=

# Writes per second against the store.
SCOUT_RATE_PER_SECOND=4

# Refuse to apply a plan touching more products than this. A one-character
# search term matches almost every product in a catalogue.
SCOUT_MAX_PRODUCTS_PER_PLAN=500

SCOUT_AUDIT_PATH=var/audit/content_updates.csv
SCOUT_ROLLBACK_DIR=var/rollback
