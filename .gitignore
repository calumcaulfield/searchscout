# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key

# Generated at runtime: the demo catalogue database, audit trails and
# rollback files. State, not source.
data/
*.db
*.db-journal
var/
content_updates.csv

# Editors and OS
.idea/
.vscode/
.DS_Store

# Editor and sed backups
*.bak
*.orig
*~

# macOS duplicates. Copying a folder in Finder produces "name 2", which no
# pattern written for "name/" will match — so they get committed by accident.
* 2
* 2.*
*\ 2/
.DS_Store

# Not used by this project, but cheap insurance if a JS toolchain is ever added.
node_modules/
